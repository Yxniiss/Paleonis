-- Script compatible avec le Query Tool de pgAdmin
-- (sans \restrict, \unrestrict, COPY ... FROM stdin ni \.)

SET client_encoding = 'UTF8';
SET standard_conforming_strings = on;
SET check_function_bodies = false;
SET client_min_messages = warning;

-- =========================
-- TABLES
-- =========================

CREATE TABLE public.datacenter (
    id_datacenter integer GENERATED ALWAYS AS IDENTITY,
    nom character varying(100) NOT NULL,
    ville character varying(100) NOT NULL,
    CONSTRAINT datacenter_pkey PRIMARY KEY (id_datacenter)
);

CREATE TABLE public.client (
    id_client integer GENERATED ALWAYS AS IDENTITY,
    nom character varying(150) NOT NULL,
    email character varying(254) NOT NULL,
    telephone character varying(30),
    date_inscription date DEFAULT CURRENT_DATE NOT NULL,
    type_client character varying(20) NOT NULL,
    denomination_sociale character varying(200),
    siret character varying(14),
    CONSTRAINT client_pkey PRIMARY KEY (id_client),
    CONSTRAINT client_email_key UNIQUE (email),
    CONSTRAINT client_check CHECK (((((type_client)::text = 'entreprise'::text) AND (siret IS NOT NULL)) OR (((type_client)::text = 'particulier'::text) AND (siret IS NULL)))),
    CONSTRAINT client_type_client_check CHECK (((type_client)::text = ANY ((ARRAY['particulier'::character varying, 'entreprise'::character varying])::text[])))
);

CREATE TABLE public.offre (
    id_offre integer GENERATED ALWAYS AS IDENTITY,
    nom character varying(150) NOT NULL,
    categorie character varying(40) NOT NULL,
    prix_mensuel_ht numeric(10,2) NOT NULL,
    en_vente boolean DEFAULT true NOT NULL,
    CONSTRAINT offre_pkey PRIMARY KEY (id_offre),
    CONSTRAINT offre_categorie_check CHECK (((categorie)::text = ANY ((ARRAY['VPS'::character varying, 'hebergement mutualise'::character varying, 'serveur dedie'::character varying, 'nom de domaine'::character varying])::text[]))),
    CONSTRAINT offre_prix_mensuel_ht_check CHECK ((prix_mensuel_ht >= (0)::numeric))
);

CREATE TABLE public.serveur (
    id_serveur integer GENERATED ALWAYS AS IDENTITY,
    nom_hote character varying(255) NOT NULL,
    adresse_ip inet NOT NULL,
    statut character varying(20) NOT NULL,
    date_mise_en_service date NOT NULL,
    id_datacenter integer NOT NULL,
    CONSTRAINT serveur_pkey PRIMARY KEY (id_serveur),
    CONSTRAINT serveur_nom_hote_key UNIQUE (nom_hote),
    CONSTRAINT serveur_adresse_ip_key UNIQUE (adresse_ip),
    CONSTRAINT serveur_statut_check CHECK (((statut)::text = ANY ((ARRAY['en service'::character varying, 'maintenance'::character varying, 'hors service'::character varying])::text[]))),
    CONSTRAINT serveur_id_datacenter_fkey FOREIGN KEY (id_datacenter) REFERENCES public.datacenter(id_datacenter) ON DELETE RESTRICT
);

CREATE TABLE public.abonnement (
    id_abonnement integer GENERATED ALWAYS AS IDENTITY,
    date_debut date DEFAULT CURRENT_DATE NOT NULL,
    date_fin date,
    statut character varying(20) NOT NULL,
    prix_souscription numeric(10,2) NOT NULL,
    id_client integer NOT NULL,
    id_offre integer NOT NULL,
    id_serveur integer,
    CONSTRAINT abonnement_pkey PRIMARY KEY (id_abonnement),
    CONSTRAINT abonnement_id_serveur_key UNIQUE (id_serveur),
    CONSTRAINT abonnement_check CHECK (((date_fin IS NULL) OR (date_fin >= date_debut))),
    CONSTRAINT abonnement_prix_souscription_check CHECK ((prix_souscription >= (0)::numeric)),
    CONSTRAINT abonnement_statut_check CHECK (((statut)::text = ANY ((ARRAY['actif'::character varying, 'suspendu'::character varying, 'resilie'::character varying])::text[]))),
    CONSTRAINT abonnement_id_client_fkey FOREIGN KEY (id_client) REFERENCES public.client(id_client) ON DELETE RESTRICT,
    CONSTRAINT abonnement_id_offre_fkey FOREIGN KEY (id_offre) REFERENCES public.offre(id_offre) ON DELETE RESTRICT,
    CONSTRAINT abonnement_id_serveur_fkey FOREIGN KEY (id_serveur) REFERENCES public.serveur(id_serveur) ON DELETE RESTRICT
);

CREATE TABLE public.technicien (
    id_technicien integer GENERATED ALWAYS AS IDENTITY,
    nom character varying(100) NOT NULL,
    prenom character varying(100) NOT NULL,
    email_professionnel character varying(254) NOT NULL,
    id_datacenter integer NOT NULL,
    CONSTRAINT technicien_pkey PRIMARY KEY (id_technicien),
    CONSTRAINT technicien_email_professionnel_key UNIQUE (email_professionnel),
    CONSTRAINT technicien_id_datacenter_fkey FOREIGN KEY (id_datacenter) REFERENCES public.datacenter(id_datacenter) ON DELETE RESTRICT
);

CREATE TABLE public.ticket (
    id_ticket integer GENERATED ALWAYS AS IDENTITY,
    sujet character varying(200) NOT NULL,
    description text NOT NULL,
    date_ouverture timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    priorite character varying(20) NOT NULL,
    statut character varying(20) DEFAULT 'ouvert'::character varying NOT NULL,
    id_client integer NOT NULL,
    id_serveur integer,
    id_technicien integer,
    CONSTRAINT ticket_pkey PRIMARY KEY (id_ticket),
    CONSTRAINT ticket_priorite_check CHECK (((priorite)::text = ANY ((ARRAY['basse'::character varying, 'normale'::character varying, 'haute'::character varying, 'critique'::character varying])::text[]))),
    CONSTRAINT ticket_statut_check CHECK (((statut)::text = ANY ((ARRAY['ouvert'::character varying, 'en cours'::character varying, 'resolu'::character varying, 'ferme'::character varying])::text[]))),
    CONSTRAINT ticket_id_client_fkey FOREIGN KEY (id_client) REFERENCES public.client(id_client) ON DELETE RESTRICT,
    CONSTRAINT ticket_id_serveur_fkey FOREIGN KEY (id_serveur) REFERENCES public.serveur(id_serveur) ON DELETE SET NULL,
    CONSTRAINT ticket_id_technicien_fkey FOREIGN KEY (id_technicien) REFERENCES public.technicien(id_technicien) ON DELETE SET NULL
);

-- =========================
-- INDEX
-- =========================

CREATE INDEX idx_abonnement_client ON public.abonnement USING btree (id_client);
CREATE INDEX idx_abonnement_offre ON public.abonnement USING btree (id_offre);
CREATE INDEX idx_serveur_datacenter_statut ON public.serveur USING btree (id_datacenter, statut);
CREATE INDEX idx_ticket_client ON public.ticket USING btree (id_client);
CREATE INDEX idx_ticket_technicien_statut ON public.ticket USING btree (id_technicien, statut);
